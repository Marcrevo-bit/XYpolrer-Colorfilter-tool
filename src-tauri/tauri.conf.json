{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XYplorer配色工具",
  "version": "1.0.0",
  "identifier": "com.marcrevo.xycolorfilter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XYplorer 颜色过滤器配方生成器",
        "width": 1500,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
