{
  // ==========================================================================
  // Tauri 运行期配置（对应 Tauri 2 的 config schema）。
  // 关键字段：
  //   productName  "XYplorer配色工具" —— 安装包/窗口展示名
  //   version      "1.1.0"           —— 与 Cargo.toml 的 version 保持一致
  //   identifier   "com.marcrevo.xycolorfilter" —— 应用唯一 ID（bundle/签名用）
  //   build.frontendDist "../ui"     —— 前端目录（单文件 WebView2 的 ui/index.html）
  //   app.windows  —— 主窗口标题/尺寸（1500x960，最小 1080x680，居中、可缩放）
  //   app.security.csp null          —— 允许内联脚本（本前端把所有 CSS/JS 内联在 index.html）
  //   bundle       —— 打包为 nsis 安装包，并指定各尺寸图标
  // ==========================================================================
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XYplorer配色工具",
  "version": "1.1.0",
  "identifier": "com.marcrevo.xycolorfilter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XYplorer 颜色过滤器配方生成器",
        "width": 1500,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
